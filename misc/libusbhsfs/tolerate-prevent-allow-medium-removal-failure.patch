--- source/usbhsfs_scsi.c
+++ source/usbhsfs_scsi.c
@@ -472,7 +472,14 @@
             eject_supported = true;
         } else {
             USBHSFS_LOG_MSG("Prevent/Allow Medium Removal failed! (interface %d, LUN %d).", drive_ctx->usb_if_id, lun);
-            if (!g_mediumPresent) goto end;
+
+            /* Some USB bridges advertise RMB == 1 but answer this optional command with a NOT READY / */
+            /* MEDIUM NOT PRESENT sense pair even though a medium is very much present (e.g. Realtek  */
